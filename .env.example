# =============================================================================
# Booking_Inventory — production env (EOI_CP-aligned, goyalhariyana.com)
# =============================================================================
# Diff vs EOI: DB=booking_inventory | S3_PREFIX=booking
# No localhost. Compose forces WS_EMIT_URL=http://ws:3002 on the Docker network.
# Set REDIS_URL yourself (external Redis) — compose does not run Redis.
# =============================================================================

NODE_ENV=production
LOG_LEVEL=info

# --- Postgres (same RDS as EOI; different database name) ---
POSTGRES_USER=goyalco_pg_user
POSTGRES_PASSWORD=
POSTGRES_DB=booking_inventory
DATABASE_URL=postgresql://goyalco_pg_user:PASSWORD@goyalco-prod-postgres.chwssswucgb8.ap-south-1.rds.amazonaws.com:5432/booking_inventory?sslmode=require
NODE_EXTRA_CA_CERTS=/ap-south-1-bundle.pem

# --- Auth / public HTTPS URLs ---
NEXTAUTH_SECRET=change-me-integration-goyalco-eoi-secret
NEXTAUTH_URL=https://sales.goyalhariyana.com
SALES_URL=https://sales.goyalhariyana.com
ADMIN_URL=https://admin.goyalhariyana.com
CUSTOMER_URL=https://booking.goyalhariyana.com
RECEPTION_URL=https://reception.goyalhariyana.com
APP_URL=https://sales.goyalhariyana.com
ROOT_DOMAIN=goyalhariyana.com
AUTH_COOKIE_DOMAIN=.goyalhariyana.com
AUTH_TRUST_HOST=true

# --- WebSocket ---
# Browser clients (public):
NEXT_PUBLIC_WS_URL=https://ws.goyalhariyana.com
# Server-side emit (Docker network DNS — NOT a public URL, NOT localhost):
WS_EMIT_URL=http://ws:3002
WS_INTERNAL_SECRET=change-me-ws-internal-secret-min-32-chars
CORS_ORIGINS=https://sales.goyalhariyana.com,https://admin.goyalhariyana.com,https://booking.goyalhariyana.com,https://reception.goyalhariyana.com

# --- Redis (external — set your own URL; not managed by compose) ---
REDIS_URL=

# --- VM host ports (must NOT collide with 80/443/3000/6379/…) ---
SALES_HOST_PORT=3100
ADMIN_HOST_PORT=3101
WS_HOST_PORT=3102
CUSTOMER_HOST_PORT=3103
RECEPTION_HOST_PORT=3104

# --- Email (Brevo) ---
BREVO_API_KEY=
EMAIL_FROM=alert@goyalco.email
EMAIL_FROM_NAME=Goyal & Co | Hariyana Group
EMAIL_LOGO_URL=https://booking.goyalhariyana.com/logo.svg

# --- Object storage (same bucket as EOI; folder = booking) ---
# Only these S3 vars are required (no BLOB_READ_WRITE_TOKEN / S3_PUBLIC_URL).
S3_REGION=ap-south-1
S3_BUCKET=goyalco-prod-assets
S3_PREFIX=booking
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=false

# --- Titan / Post CRM ---
TITAN_CRM_PROVIDER=mock
TITAN_CRM_API_URL=
TITAN_CRM_API_KEY=
TITAN_CRM_SEARCH_TIMEOUT_MS=3000
POST_CRM_PROVIDER=mock

# --- EOI Partner Portal ↔ Booking ---
INTEGRATION_WEBHOOK_SECRET=change-me-integration-goyalco-eoi-secret
INTEGRATION_HUB_URL=https://admin.goyalhariyana.com
BOOKING_INVENTORY_URL=https://admin.goyalhariyana.com
EOI_CP_URL=https://leads.partnergoyalco.com

# --- Goyal Hariyana CRM (Reception) ---
GOYAL_CRM_API_URL=https://goyalhariyanacrm.in/api
EOI_API_KEY=
BEARER_AUTHORIZATION=
GOYAL_CRM_API_TOKEN=
GOYAL_CRM_GET_TIMEOUT_MS=3000
GOYAL_CRM_MUTATION_TIMEOUT_MS=15000
RECEPTION_SEARCH_EXTERNAL_TIMEOUT_MS=3000

EVENT_BUS_PROVIDER=
PII_ENCRYPTION_KEY=change-me-integration-goyalco-pii-secret

# --- First boot (sales) ---
ORGANIZATION_NAME=Goyal & Co | Hariyana Group
ORGANIZATION_SLUG=goyal-co
SUPER_ADMIN_EMAIL=superadmin@goyalco.com
SUPER_ADMIN_NAME=Super Admin
SUPER_ADMIN_PASSWORD=
