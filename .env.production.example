# =============================================================================
# Booking_Inventory — single combined production env (AWS / Docker)
# =============================================================================
# Copy to `.env.production` and fill secrets. Pass to containers with:
#   docker compose -f docker-compose.production.yml --env-file .env.production up -d
#   docker run --env-file .env.production ...
# Do NOT bake this file into the image. Never commit real secrets.
# =============================================================================

NODE_ENV=production
LOG_LEVEL=info

# --- Database (RDS) ---
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/booking_inventory?schema=public&sslmode=require
# Optional: RDS CA bundle path inside the container (if using verify-full)
# NODE_EXTRA_CA_CERTS=/ap-south-1-bundle.pem

# --- Auth (generate: openssl rand -base64 32) ---
# Prefer a unique NEXTAUTH_SECRET per app in high-security setups; one shared secret works if URLs differ.
NEXTAUTH_SECRET=change-me-nextauth-secret-min-32-chars
# Per-app public origins (ALB / CloudFront / custom domains)
NEXTAUTH_URL=https://sales.your-domain.com
SALES_URL=https://sales.your-domain.com
ADMIN_URL=https://admin.your-domain.com
CUSTOMER_URL=https://booking.your-domain.com
RECEPTION_URL=https://reception.your-domain.com
# Optional alias used by some helpers
APP_URL=https://sales.your-domain.com

# --- Realtime WebSocket ---
WS_EMIT_URL=http://ws:3002
NEXT_PUBLIC_WS_URL=https://ws.your-domain.com
WS_PORT=3002
PORT=3000
HOSTNAME=0.0.0.0
WS_INTERNAL_SECRET=change-me-ws-internal-secret-min-32-chars
CORS_ORIGINS=https://sales.your-domain.com,https://admin.your-domain.com,https://booking.your-domain.com,https://reception.your-domain.com

# --- Email (Brevo) — required on sales, customer, reception ---
BREVO_API_KEY=
EMAIL_FROM=alert@goyalco.email
EMAIL_FROM_NAME=Goyal & Co | Hariyana Group
# EMAIL_LOGO_URL=https://booking.your-domain.com/logo.svg

# --- Object storage (priority: Vercel Blob → S3 → local) ---
# Leave BLOB_READ_WRITE_TOKEN empty on AWS so STORAGE_PROVIDER=s3 wins.
# AWS production: prefer S3 (or IAM task role + AWS_ACCESS_KEY_ID unset).
BLOB_READ_WRITE_TOKEN=
STORAGE_PROVIDER=s3
STORAGE_LOCAL_PATH=/app/storage
STORAGE_PUBLIC_URL=/api/files
S3_BUCKET=goyal-booking-documents
S3_REGION=ap-south-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Also accepted: AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY (IAM task role)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
S3_PUBLIC_URL=

# --- Redis (optional) ---
REDIS_URL=

# --- Integrations: Titan CRM ---
TITAN_CRM_PROVIDER=mock
TITAN_CRM_API_URL=
TITAN_CRM_API_KEY=
TITAN_CRM_SEARCH_TIMEOUT_MS=3000
POST_CRM_PROVIDER=mock

# --- Integrations: EOI Partner Portal ↔ Booking ---
INTEGRATION_WEBHOOK_SECRET=change-me-integration-goyalco-eoi-secret
INTEGRATION_HUB_URL=https://admin.your-domain.com
BOOKING_INVENTORY_URL=https://admin.your-domain.com
EOI_CP_URL=https://leads.partnergoyalco.com
# PARTNER_PORTAL_URL=
# NEXT_PUBLIC_EOI_CP_URL=

# --- Goyal Hariyana CRM (Reception) ---
GOYAL_CRM_API_URL=https://goyalhariyanacrm.in/api
# Partner permanent token (list/create). Aliases: BEARER_AUTHORIZATION, GOYAL_CRM_BEARER_TOKEN
EOI_API_KEY=
BEARER_AUTHORIZATION=
# Optional staff Supabase JWT for book/site-visit
GOYAL_CRM_API_TOKEN=
GOYAL_CRM_GET_TIMEOUT_MS=3000
GOYAL_CRM_MUTATION_TIMEOUT_MS=15000
RECEPTION_SEARCH_EXTERNAL_TIMEOUT_MS=3000

# --- Event bus (optional) ---
EVENT_BUS_PROVIDER=

# --- Docker / ECS boot flags ---
# Sales (or a one-shot migrate task) should run migrate; other apps set SKIP_DB_MIGRATE=1.
# SKIP_DB_MIGRATE=1
# SKIP_ADMIN_BOOTSTRAP=1
# DB_PUSH_ON_BOOT=1
# Optional: point Prisma at RDS CA inside the image
# NODE_EXTRA_CA_CERTS=/ap-south-1-bundle.pem

# --- First-time Super Admin bootstrap (run once on sales, then remove password) ---
# ORGANIZATION_NAME=Goyal & Co
# ORGANIZATION_SLUG=goyal-co
# SUPER_ADMIN_EMAIL=admin@yourcompany.com
# SUPER_ADMIN_NAME=Super Admin
# SUPER_ADMIN_PASSWORD=use-a-strong-password-min-12-chars

# --- NEVER in production ---
# SEED_DEMO=true
